[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/controllers/title_menu.gd" id="1"]

[node name="TitleMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBox" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/separation = 24
custom_minimum_size = Vector2(900, 0)

[node name="Title" type="Label" parent="CenterContainer/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 54
horizontal_alignment = 1
text = "ELEMENTAL BALANCE: FIRE CHAPTER"

[node name="Subtitle" type="Label" parent="CenterContainer/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
horizontal_alignment = 1
text = "Choose your path and begin the adventure"

[node name="Start" type="Button" parent="CenterContainer/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(460, 100)
theme_override_font_sizes/font_size = 40
text = "Start Adventure"

[connection signal="pressed" from="CenterContainer/VBox/Start" to="." method="_on_start_pressed"]

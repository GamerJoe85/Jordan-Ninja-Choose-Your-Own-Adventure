[gd_scene load_steps=3 format=3]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_title_box"]
bg_color = Color(0, 0, 0, 0.42)
corner_radius_top_left = 10
corner_radius_top_right = 10
corner_radius_bottom_right = 10
corner_radius_bottom_left = 10


[ext_resource type="Script" path="res://scripts/controllers/title_menu.gd" id="1"]

[node name="TitleMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")


[node name="TitleBackground" type="TextureRect" parent="."]
unique_name_in_owner = true
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
expand_mode = 1
stretch_mode = 6
modulate = Color(1, 1, 1, 0.9)

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="TitleBox" type="PanelContainer" parent="CenterContainer"]
layout_mode = 2
size_flags_horizontal = 4
custom_minimum_size = Vector2(860, 0)
theme_override_styles/panel = SubResource("StyleBoxFlat_title_box")

[node name="VBox" type="VBoxContainer" parent="CenterContainer/TitleBox"]
layout_mode = 2
theme_override_constants/separation = 20
custom_minimum_size = Vector2(820, 0)

[node name="Title" type="Label" parent="CenterContainer/TitleBox/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 46
horizontal_alignment = 1
text = "ELEMENTAL BALANCE: FIRE CHAPTER"

[node name="Subtitle" type="Label" parent="CenterContainer/TitleBox/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
horizontal_alignment = 1
text = "Choose your path and begin the adventure"

[node name="Start" type="Button" parent="CenterContainer/TitleBox/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(420, 88)
theme_override_font_sizes/font_size = 34
text = "Start Adventure"

[connection signal="pressed" from="CenterContainer/TitleBox/VBox/Start" to="." method="_on_start_pressed"]

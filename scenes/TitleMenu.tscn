[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/controllers/title_menu.gd" id="1"]

[node name="TitleMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Margin" type="MarginContainer" parent="CenterContainer"]
layout_mode = 2
theme_override_constants/margin_left = 48
theme_override_constants/margin_top = 48
theme_override_constants/margin_right = 48
theme_override_constants/margin_bottom = 48

[node name="VBox" type="VBoxContainer" parent="CenterContainer/Margin"]
layout_mode = 2
theme_override_constants/separation = 28
size_flags_horizontal = 4

[node name="Title" type="Label" parent="CenterContainer/Margin/VBox"]
layout_mode = 2
size_flags_horizontal = 4
theme_override_font_sizes/font_size = 42
horizontal_alignment = 1
autowrap_mode = 3
text = "ELEMENTAL BALANCE: FIRE CHAPTER"

[node name="Start" type="Button" parent="CenterContainer/Margin/VBox"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(360, 110)
theme_override_font_sizes/font_size = 42
text = "Start"

[connection signal="pressed" from="CenterContainer/Margin/VBox/Start" to="." method="_on_start_pressed"]
